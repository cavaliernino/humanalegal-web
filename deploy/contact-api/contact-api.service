# /etc/systemd/system/contact-api.service
#
# Instalación:
#   sudo mkdir -p /opt/contact-api && sudo cp contact_api.py /opt/contact-api/
#   sudo mkdir -p /etc/contact-api && sudo cp env.example /etc/contact-api/env
#   (editar /etc/contact-api/env con las credenciales SMTP reales)
#   sudo chmod 600 /etc/contact-api/env
#   sudo cp contact-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now contact-api
#
# Logs: journalctl -u contact-api -f

[Unit]
Description=Formulario de contacto humanalegal.cl
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/contact-api/contact_api.py
EnvironmentFile=/etc/contact-api/env
Restart=on-failure
RestartSec=5

# Hardening
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
