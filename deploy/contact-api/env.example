# Copiar a /etc/contact-api/env y completar. chmod 600.
#
# SMTP del proveedor del buzón contacto@humanalegal.cl
# (Zoho, Google Workspace, Migadu, etc. — puerto 587 STARTTLS o 465 SSL)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=web@humanalegal.cl
SMTP_PASS=changeme

# Destino y remitente de las consultas
MAIL_TO=contacto@humanalegal.cl
MAIL_FROM=web@humanalegal.cl

# Dónde escucha el proceso (nginx hace proxy_pass aquí)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8085
