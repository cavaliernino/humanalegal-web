---
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { SITE_URL } from '../config';

interface Props {
	entry: CollectionEntry<'blog'>;
	translation?: CollectionEntry<'blog'>;
}
const { entry, translation } = Astro.props;
const lang = entry.data.lang;
const slugOf = (id: string) => id.replace(/^(es|en)\//, '');

const base = lang === 'es' ? '' : '/en';
const otherBase = lang === 'es' ? '/en' : '';
const url = `${SITE_URL}${base}/blog/${slugOf(entry.id)}/`;
const langSwitchHref = translation
	? `${otherBase}/blog/${slugOf(translation.id)}/`
	: `${otherBase}/blog/`;

const { Content } = await render(entry);

const fmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-CL' : 'en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const t =
	lang === 'es'
		? {
				back: '← Volver al blog',
				published: 'Publicado el',
				updated: 'Actualizado el',
				by: 'Por',
				ctaTitle: '¿Su caso necesita orientación?',
				ctaText: 'Cada situación es distinta. Conversemos sobre la suya.',
				cta: 'Agendar una consulta',
			}
		: {
				back: '← Back to blog',
				published: 'Published',
				updated: 'Updated',
				by: 'By',
				ctaTitle: 'Does your case need guidance?',
				ctaText: 'Every situation is different. Let’s talk about yours.',
				cta: 'Schedule a consultation',
			};

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: entry.data.title,
	description: entry.data.description,
	inLanguage: lang === 'es' ? 'es-CL' : 'en',
	datePublished: entry.data.pubDate.toISOString(),
	dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
	author: { '@type': 'Person', name: entry.data.author },
	publisher: { '@type': 'Organization', name: 'Humana Legal', url: SITE_URL },
	mainEntityOfPage: url,
	url,
};

const blogIndex = `${base}/blog/`;
const contactHref = `${base}/#${lang === 'es' ? 'contacto' : 'contact'}`;
---

<Base
	title={`${entry.data.title} — Humana Legal`}
	description={entry.data.description}
	canonical={url}
	alternateEs={lang === 'es' ? url : `${SITE_URL}${langSwitchHref}`}
	alternateEn={lang === 'en' ? url : `${SITE_URL}${langSwitchHref}`}
	ogType="article"
	ogTitle={entry.data.title}
	ogDescription={entry.data.description}
	jsonLd={jsonLd}
	langSwitchHref={langSwitchHref}
>
	<article class="post section">
		<div class="container post__inner">
			<a class="post__back" href={blogIndex}>{t.back}</a>

			<div class="post__meta">
				<time datetime={entry.data.pubDate.toISOString()}>
					{t.published} {fmt.format(entry.data.pubDate)}
				</time>
				{entry.data.tags.length > 0 && <span class="post__tags">{entry.data.tags.join(' · ')}</span>}
			</div>

			<h1 class="post__title">{entry.data.title}</h1>
			<p class="post__lede">{entry.data.description}</p>
			<p class="post__byline">{t.by} {entry.data.author}</p>

			<div class="post-content">
				<Content />
			</div>

			<aside class="post__cta">
				<h2>{t.ctaTitle}</h2>
				<p>{t.ctaText}</p>
				<a class="btn btn--primary" href={contactHref}>{t.cta}</a>
			</aside>
		</div>
	</article>
</Base>

<style>
	.post__inner {
		max-width: 720px;
	}
	.post__back {
		display: inline-block;
		font-size: 0.9rem;
		color: var(--clay);
		text-decoration: none;
		margin-bottom: 2.5rem;
	}
	.post__back:hover {
		text-decoration: underline;
	}
	.post__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin-bottom: 1rem;
	}
	.post__tags {
		color: var(--clay);
		font-weight: 600;
	}
	.post__title {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2rem, 5vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
		color: var(--ink);
	}
	.post__lede {
		font-size: 1.2rem;
		line-height: 1.5;
		color: var(--ink-2);
		margin: 0 0 1.25rem;
	}
	.post__byline {
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin: 0 0 2.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--line);
	}
	.post__cta {
		margin-top: 3.5rem;
		padding: 2rem;
		background: var(--bone);
		border: 1px solid var(--line);
		border-radius: 4px;
	}
	.post__cta h2 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.5rem;
		margin: 0 0 0.5rem;
	}
	.post__cta p {
		color: var(--ink-2);
		margin: 0 0 1.25rem;
	}
</style>

<style is:global>
	/* Markdown renderizado del artículo */
	.post-content {
		font-size: 1.08rem;
		line-height: 1.75;
		color: var(--ink-2);
	}
	.post-content > * + * {
		margin-top: 1.25rem;
	}
	.post-content h2 {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.7rem;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--ink);
		margin-top: 2.75rem;
	}
	.post-content h3 {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.3rem;
		color: var(--ink);
		margin-top: 2rem;
	}
	.post-content a {
		color: var(--clay);
		text-underline-offset: 3px;
	}
	.post-content ul,
	.post-content ol {
		padding-left: 1.4rem;
	}
	.post-content li + li {
		margin-top: 0.5rem;
	}
	.post-content strong {
		color: var(--ink);
	}
	.post-content blockquote {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		border-left: 3px solid var(--clay);
		background: var(--bone);
		color: var(--ink-2);
		font-size: 0.95rem;
	}
	.post-content blockquote p {
		margin: 0;
	}
	.post-content hr {
		border: none;
		border-top: 1px solid var(--line);
		margin: 2.5rem 0;
	}
	.post-content em {
		color: var(--ink-soft);
	}
</style>
