---
import { content, getLocale } from '../i18n/content';

const locale = getLocale(Astro.currentLocale);
const { marquee } = content[locale];

// La pista se duplica para que la animación de scroll sea continua.
const track = [...marquee, ...marquee];
---

<div class="marquee" aria-hidden="true">
	<div class="marquee__track">
		{
			track.map((value) => (
				<>
					<span>{value}</span>
					<span>✦</span>
				</>
			))
		}
	</div>
</div>
