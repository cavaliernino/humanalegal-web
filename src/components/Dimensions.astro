---
import { content, getLocale } from '../i18n/content';

const locale = getLocale(Astro.currentLocale);
const { dimensions } = content[locale];
---

<section class="dims section" id={dimensions.id}>
	<div class="container">
		<div class="section__head">
			<span class="section__label">{dimensions.label}</span>
			<h2 class="section__title" set:html={dimensions.titleHtml} />
			<p class="dims__lede">{dimensions.lede}</p>
		</div>

		<div class="areas__grid">
			{
				dimensions.items.map((dim) => (
					<article class="area" id={dim.id}>
						<h3 class="area__title">{dim.title}</h3>
						<p class="area__desc">{dim.desc}</p>
						<ul class="area__list">
							{dim.list.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
