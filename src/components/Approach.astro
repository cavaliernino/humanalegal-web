---
import { content, getLocale } from '../i18n/content';

const locale = getLocale(Astro.currentLocale);
const { approach } = content[locale];
---

<section class="approach section section--dark" id={approach.id}>
	<div class="container approach__inner">
		<span class="section__label section__label--light">{approach.label}</span>
		<h2 class="section__title section__title--light" set:html={approach.titleHtml} />

		<div class="approach__grid">
			{
				approach.items.map((item) => (
					<div class="approach__item">
						<span class="approach__num">{item.num}</span>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
